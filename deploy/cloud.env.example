# Render backend ONLY. Use a NEW application database, separate from Semfolio.
NODE_ENV=production
HOST=0.0.0.0
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/freelancechain_demo
JWT_SECRET=replace-with-a-stable-random-value-of-at-least-32-characters
APP_ORIGIN=https://YOUR-FREELANCECHAIN-FRONTEND.vercel.app
FC_PROXY_SECRET=replace-with-the-same-private-random-value-used-in-vercel
PRIVATE_UPLOAD_BACKEND=mongo
UPLOAD_USER_QUOTA_MB=20
UPLOAD_SHARED_QUOTA_MB=100
EVENT_EMAILS_ENABLED=false
# Vercel project settings (NOT Render; leave REACT_APP_API_URL unset):
# FREELANCECHAIN_BACKEND_ORIGIN=https://YOUR-FREELANCECHAIN-SERVICE.onrender.com
# FC_PROXY_SECRET=<same private secret as Render>

# Alternative: use a username-only MONGO_URI and set MONGO_PASSWORD privately.
# Example address: mongodb+srv://fc_app@CLUSTER/freelancechain_demo?retryWrites=true&w=majority&authSource=admin
# MONGO_PASSWORD=
