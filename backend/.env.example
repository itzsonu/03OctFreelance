MONGO_URI=mongodb://127.0.0.1:27017/freelancechain
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Private upload bytes default to backend/.private-uploads and must stay outside public/build.
# PRIVATE_UPLOAD_DIR=D:/freelancechain-private-uploads
# Public frontend origin used to build password-reset links. Use HTTPS outside localhost.
APP_ORIGIN=http://localhost:3000
# Production email delivery: set both values below for Resend.
# RESEND_API_KEY=replace-with-your-api-key
# RESET_FROM_EMAIL=FreelanceChain <reset@your-domain.example>
# Small local demo Gmail alternative (requires Google 2-Step Verification and an App Password; use a dedicated sender account).
# RESET_DELIVERY=gmail
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password
# Local-only alternative: print the reset link in the backend terminal.
# RESET_DELIVERY=console
# Optional AI-assisted applicant comparison and milestone drafting. Never expose this key to the React build.
# OPENAI_API_KEY=replace-with-your-api-key
# Optional milestone drafting model (default gpt-4o-mini).
# OPENAI_PLAN_MODEL=gpt-4o-mini
# Set this if the frontend is hosted on another origin. Comma-separate multiple origins.
# CLIENT_ORIGIN=https://your-frontend.example
