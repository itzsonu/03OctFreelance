MONGO_URI=mongodb://127.0.0.1:27017/freelancechain
# Kept under its existing name; now signs session-bound CSRF values, not browser JWTs.
JWT_SECRET=replace-with-a-long-random-secret
# Production requires NODE_ENV=production and an exact HTTPS APP_ORIGIN.
# NODE_ENV=production
PORT=5000
# Optional event alerts stay disabled until email delivery is configured and approved.
EVENT_EMAILS_ENABLED=false
# Private upload bytes default to backend/.private-uploads and must stay outside public/build.
# PRIVATE_UPLOAD_DIR=D:/freelancechain-private-uploads
# Public frontend origin used to build password-reset links. Use HTTPS outside localhost.
APP_ORIGIN=http://localhost:3000
# Production email delivery: set both values below for Resend.
# RESEND_API_KEY=replace-with-your-api-key
# RESET_FROM_EMAIL=FreelanceChain <reset@your-domain.example>
# Small local demo Gmail alternative (requires Google 2-Step Verification and an App Password; use a dedicated sender account).
# RESET_DELIVERY=gmail
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password
# Local-only alternative: print the reset link in the backend terminal.
# RESET_DELIVERY=console
# Optional AI-assisted applicant comparison and milestone drafting. Never expose this key to the React build.
# OPENAI_API_KEY=replace-with-your-api-key
# Optional milestone drafting model (default gpt-4o-mini).
# OPENAI_PLAN_MODEL=gpt-4o-mini
# Set this if the frontend is hosted on another origin. Comma-separate multiple origins.
# CLIENT_ORIGIN=https://your-frontend.example
# Trust only the actual reverse proxy IPs/subnets; never set to true or a hop count.
# Leave unset when the backend receives connections directly.
# TRUST_PROXY=127.0.0.1/32,::1/128

# Per-user attachment allowance (1–10000 MB); 1000 files/account; 10 MB/file, 3/request.
UPLOAD_USER_QUOTA_MB=500

# Optional secret-file alternatives (configure value OR file).
# MONGO_URI_FILE=/run/secrets/mongo_uri
# JWT_SECRET_FILE=/run/secrets/session_secret
# RESTORE_MONGO_URI_FILE=/run/secrets/restore_mongo_uri
# HOST=0.0.0.0

# Cloud demo: MongoDB stores private attachment bytes (no Render-local disk dependency).
# Existing files remain marked local; use the offline migration preview before moving existing data.
# PRIVATE_UPLOAD_BACKEND=mongo
# UPLOAD_USER_QUOTA_MB=20
# UPLOAD_SHARED_QUOTA_MB=100
# Same random secret in Render and Vercel; never prefix it with REACT_APP_.
# FC_PROXY_SECRET=replace-with-a-private-random-value-of-at-least-32-characters

# Free Gemini API alternative: use a Google AI Studio project on the Free plan.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=replace-privately-never-commit
